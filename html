    <!-- ========================================================================= -->
    <div class="modal-overlay" id="newLeadModal">
        <div class="modal-card">
            <div class="modal-header">
                <div class="modal-title-wrap">
                    <i class="fa-solid fa-bullseye text-indigo"></i>
                    <h3 class="modal-title">Record New Inbound Lead</h3>
                </div>
                <button class="modal-close-btn" data-close-modal="newLeadModal">&times;</button>
            </div>
            <form id="newLeadForm">
                <div class="modal-body">
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="leadName">Prospect Full Name *</label>
                            <input type="text" id="leadName" placeholder="e.g. Eleanor Vance" required>
                        </div>
                        <div class="form-group">
                            <label for="leadEmail">Email Address *</label>
                            <input type="email" id="leadEmail" placeholder="eleanor@example.co.uk" required>
                        </div>
                        <div class="form-group">
                            <label for="leadPhone">Phone Number *</label>
                            <input type="tel" id="leadPhone" placeholder="+44 7700 900123" required>
                        </div>
                        <div class="form-group">
                            <label for="leadPostcode">Postcode / City *</label>
                            <input type="text" id="leadPostcode" placeholder="SW1A 1AA, London" required>
                        </div>
                        <div class="form-group">
                            <label for="leadService">Requested Service *</label>
                            <select id="leadService" required>
                                <!-- Injected dynamically -->
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="leadValue">Estimated Value (£)</label>
                            <input type="number" id="leadValue" value="85.00" step="5">
                        </div>
                        <div class="form-group">
                            <label for="leadSource">Acquisition Source</label>
                            <select id="leadSource">
                                <option value="Website Form">Website Form</option>
                                <option value="Google Search / Maps">Google Search / Maps</option>
                                <option value="WhatsApp Direct">WhatsApp Direct</option>
                                <option value="Referral">Customer Referral</option>
                                <option value="Social Media">Instagram / Facebook</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="leadInitialStatus">Initial Pipeline Status</label>
                            <select id="leadInitialStatus">
                                <option value="New" selected>New Inquiry</option>
                                <option value="Contacted">Contacted</option>
                                <option value="Quote Sent">Quote Sent</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-close-modal="newLeadModal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Save Lead</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- MODAL 3: CONVERT LEAD TO CUSTOMER & PROPERTY MODAL (Spec Section 3.1)       -->
    <!-- ========================================================================= -->
    <div class="modal-overlay" id="convertLeadModal">
        <div class="modal-card">
            <div class="modal-header">
                <div class="modal-title-wrap">
                    <i class="fa-solid fa-user-check text-success"></i>
                    <h3 class="modal-title">Convert Lead to Customer & Property</h3>
                </div>
                <button class="modal-close-btn" data-close-modal="convertLeadModal">&times;</button>
            </div>
            <form id="convertLeadForm">
                <input type="hidden" id="convertLeadId">
                <div class="modal-body">
                    <div class="alert-banner alert-info">
                        <i class="fa-solid fa-circle-info"></i>
                        <span>This will atomically create a <strong>Customer Account</strong>, a <strong>Property Location</strong>, and optionally generate their <strong>First Scheduled Job</strong> without duplication.</span>
                    </div>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Customer Name</label>
                            <input type="text" id="convertCustomerName" readonly class="input-readonly">
                        </div>
                        <div class="form-group">
                            <label>Email</label>
                            <input type="email" id="convertCustomerEmail" readonly class="input-readonly">
                        </div>
                        <div class="form-group full-width">
                            <label for="convertPropertyAddress">Property Street Address *</label>
                            <input type="text" id="convertPropertyAddress" placeholder="e.g. 42 Kensington Park Road" required>
                        </div>
                        <div class="form-group">
                            <label for="convertPropertyPostcode">Postcode *</label>
                            <input type="text" id="convertPropertyPostcode" required>
                        </div>
                        <div class="form-group">
                            <label for="convertAccessNotes">Key Safe / Access Instructions</label>
                            <input type="text" id="convertAccessNotes" placeholder="Lockbox code 4821 by side gate">
                        </div>
                        <div class="form-group full-width">
                            <label class="checkbox-label">
                                <input type="checkbox" id="convertCreateFirstJob" checked>
                                <span>Immediately schedule first service job for this customer</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-close-modal="convertLeadModal">Cancel</button>
                    <button type="submit" class="btn btn-success"><i class="fa-solid fa-check-double"></i> Complete Conversion</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- MODAL 4: STRIPE PAYMENT SIMULATOR MODAL (Spec Section 11)                   -->
    <!-- ========================================================================= -->
    <div class="modal-overlay" id="stripePaymentModal">
        <div class="modal-card modal-card-sm">
            <div class="modal-header">
                <div class="stripe-badge-header">
                    <span class="stripe-logo"><i class="fa-brands fa-stripe text-indigo"></i> Stripe Checkout</span>
                    <span class="badge badge-indigo">Test Mode</span>
                </div>
                <button class="modal-close-btn" data-close-modal="stripePaymentModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="stripe-summary-box">
                    <div class="stripe-amount-row">
                        <span>Invoice Balance Due</span>
                        <strong class="stripe-total-amount" id="stripeModalAmount">£65.00</strong>
                    </div>
                    <div class="stripe-meta-row">
                        <span id="stripeModalInvNumber">INV-2026-004</span>
                        <span id="stripeModalCustomer">Sarah Jenkins</span>
                    </div>
                </div>

                <form id="stripePaymentForm">
                    <input type="hidden" id="stripePayInvoiceId">
                    <div class="form-group">
                        <label>Card Information (Test Card Auto-Filled)</label>
                        <div class="mock-card-input-box">
                            <i class="fa-solid fa-credit-card"></i>
                            <input type="text" id="mockCardNumber" value="4242 •••• •••• 4242" readonly>
                            <span class="card-brand">VISA</span>
                        </div>
                    </div>
                    <div class="form-row-grid">
                        <div class="form-group">
                            <label>Expiry</label>
                            <input type="text" value="12/28" readonly>
                        </div>
                        <div class="form-group">
                            <label>CVC</label>
                            <input type="text" value="123" readonly>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Cardholder Name</label>
                        <input type="text" id="mockCardHolder" value="Customer Name" required>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block btn-lg" id="stripeSubmitPayBtn">
                        <i class="fa-solid fa-lock"></i> Pay <span id="stripeBtnPayAmount">£65.00</span>
                    </button>
                </form>

                <div class="stripe-security-notice">
                    <i class="fa-solid fa-shield-halved"></i> 256-Bit Encrypted · PCI-DSS Compliant via Stripe Webhooks
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- MODAL 5: STAFF / CLEANER MOBILE SIMULATION PORTAL (Spec Section 6 & 16)    -->
    <!-- ========================================================================= -->
    <div class="modal-overlay modal-mobile-sim-overlay" id="staffMobileModal">
        <div class="phone-simulator-frame">
            <div class="phone-speaker"></div>
            <div class="phone-screen">
                
                <!-- Phone Top Bar -->
                <div class="phone-status-bar">
                    <span class="phone-time" id="phoneClock">09:41</span>
                    <div class="phone-icons">
                        <i class="fa-solid fa-wifi"></i>
                        <i class="fa-solid fa-battery-full"></i>
                    </div>
                </div>

                <!-- Phone Header -->
                <div class="phone-header">
                    <div class="phone-user-chip">
                        <div class="phone-avatar" id="mobileStaffAvatar">EM</div>
                        <div>
                            <h4 id="mobileStaffName">Emma Watson</h4>
                            <span class="phone-sub-role" id="mobileStaffRole">Field Staff</span>
                        </div>
                    </div>
                    <button class="phone-close-btn" data-close-modal="staffMobileModal" title="Close Phone Simulator">&times;</button>
                </div>

                <!-- Phone Content Area -->
                <div class="phone-content" id="phoneContent">
                    <div class="phone-today-summary">
                        <span class="phone-date-label" id="phoneTodayLabel">Today's Assigned Jobs</span>
                        <span class="phone-jobs-count" id="phoneJobsCount">3 Jobs</span>
                    </div>

                    <!-- Phone Job Cards Container -->
                    <div class="phone-jobs-list" id="phoneJobsList">
                        <!-- Populated dynamically with active jobs for assigned cleaner -->
                    </div>
                </div>

                <!-- Phone Bottom Tab Bar -->
                <div class="phone-tab-bar">
                    <button class="phone-tab-btn active"><i class="fa-solid fa-list-check"></i><span>Jobs</span></button>
                    <button class="phone-tab-btn"><i class="fa-solid fa-clock"></i><span>Hours</span></button>
                    <button class="phone-tab-btn"><i class="fa-solid fa-user"></i><span>Profile</span></button>
                </div>

            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- MODAL 6: AGENT EXECUTION POPUP MODAL                                      -->
    <!-- ========================================================================= -->
    <div class="modal-overlay" id="agentExecutionModal">
        <div class="modal-card modal-card-agent">
            <div class="modal-header agent-modal-header">
                <div class="modal-title-wrap">
                    <div class="agent-avatar-glow"><i class="fa-solid fa-robot"></i></div>
                    <div>
                        <h3 class="modal-title">Autonomous AI Operations Agent</h3>
                        <span class="agent-sub-status"><span class="agent-pulse-dot"></span> Ready for Autonomous Execution</span>
                    </div>
                </div>
                <button class="modal-close-btn" data-close-modal="agentExecutionModal">&times;</button>
            </div>
            <div class="modal-body p-0">
                <div class="agent-modal-quick-bar">
                    <select id="modalAgentGoalSelect">
                        <option value="full_triage">Full Autonomous Triage (Recommended)</option>
                        <option value="dispatch_jobs">Smart Staff Dispatch (Assign All Unassigned)</option>
                        <option value="convert_leads">Inbound Lead Auto-Conversion</option>
                        <option value="recover_invoices">Revenue Protection (Chase Overdue via Stripe)</option>
                        <option value="recurring_cycles">Recurring Schedule Job Generation</option>
                    </select>
                    <button class="btn btn-agent-pulse btn-sm" id="modalExecuteAgentBtn">
                        <i class="fa-solid fa-play"></i> Execute
                    </button>
                </div>

                <!-- Terminal window inside modal -->
                <div class="terminal-body terminal-body-modal" id="modalAgentTerminalBody">
                    <div class="term-line term-system"><span class="term-tag">[SYSTEM]</span> Agent Runtime v2.4 active. Model: Gemini 3.8 Flash Agentic.</div>
                    <div class="term-line term-dim"><span class="term-tag">[INFO]</span> Select a goal above or click Execute to run the autonomous triage cycle.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-close-modal="agentExecutionModal">Close</button>
                <button type="button" class="btn btn-primary btn-sm" id="modalGoToAgentViewBtn"><i class="fa-solid fa-expand"></i> Open Full Mission Control</button>
            </div>
        </div>
    </div>

    <!-- Toast Notification Hub -->
    <div class="toast-hub" id="toastHub"></div>

    <!-- Core Application Logic -->
    <script src="app.js"></script>
</body>
</html>
