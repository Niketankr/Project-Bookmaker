<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OmniService OS | Multi-Industry Booking & Field Operations SaaS</title>
    <meta name="description" content="Next-generation multi-tenant booking, scheduling, field staff execution, invoicing, and automation platform for cleaning companies, barbers, hotels, and service businesses.">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Main Style Sheet -->
    <link rel="stylesheet" href="style.css">
</head>
<body class="saas-app dark-theme">

    <!-- Application Shell -->
    <div class="app-layout">
        
        <!-- Left Sidebar Navigation -->
        <aside class="sidebar" id="appSidebar">
            <div class="sidebar-header">
                <div class="brand-logo">
                    <div class="brand-icon">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                    <div class="brand-details">
                        <span class="brand-name">OmniService</span>
                        <span class="brand-tagline">OPERATING SYSTEM</span>
                    </div>
                </div>
                <button class="sidebar-collapse-btn" id="sidebarCollapseBtn" title="Toggle Sidebar">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
            </div>

            <!-- Workspace / Business Switcher -->
            <div class="workspace-selector-card">
                <div class="workspace-meta">
                    <span class="workspace-label">ACTIVE WORKSPACE</span>
                    <div class="workspace-title-row">
                        <span class="workspace-name" id="currentBusinessName">Apex Cleaners UK</span>
                        <span class="badge badge-industry" id="currentIndustryBadge">Cleaning SaaS</span>
                    </div>
                </div>
                <button class="btn-icon-xs" id="quickSwitchIndustryBtn" title="Switch Industry Preset">
                    <i class="fa-solid fa-sliders"></i>
                </button>
            </div>

            <!-- Navigation Sections -->
            <nav class="sidebar-nav">
                <div class="nav-group-label">OPERATIONS</div>
                <ul class="nav-list">
                    <li>
                        <a href="#dashboard" class="nav-item active" data-view="dashboard">
                            <i class="fa-solid fa-chart-pie"></i>
                            <span>Dashboard</span>
                            <span class="nav-badge" id="navTodayJobsBadge">18</span>
                        </a>
                    </li>
                    <li>
                        <a href="#leads" class="nav-item" data-view="leads">
                            <i class="fa-solid fa-bullseye"></i>
                            <span>Leads & Quotes</span>
                            <span class="nav-badge badge-warning" id="navLeadsBadge">5</span>
                        </a>
                    </li>
                    <li>
                        <a href="#customers" class="nav-item" data-view="customers">
                            <i class="fa-solid fa-users"></i>
                            <span>Customers</span>
                        </a>
                    </li>
                    <li>
                        <a href="#properties" class="nav-item" data-view="properties">
                            <i class="fa-solid fa-location-dot"></i>
                            <span id="navPropertiesLabel">Properties & Units</span>
                        </a>
                    </li>
                    <li>
                        <a href="#jobs" class="nav-item" data-view="jobs">
                            <i class="fa-solid fa-calendar-check"></i>
                            <span>Jobs & Bookings</span>
                            <span class="nav-badge badge-danger" id="navUnassignedBadge">3</span>
                        </a>
                    </li>
                    <li>
                        <a href="#calendar" class="nav-item" data-view="calendar">
                            <i class="fa-solid fa-calendar-days"></i>
                            <span>Live Calendar</span>
                        </a>
                    </li>
                    <li>
                        <a href="#agent" class="nav-item" data-view="agent" id="sidebarAgentNavBtn">
                            <i class="fa-solid fa-robot"></i>
                            <span>AI Agent Ops</span>
                            <span class="nav-badge badge-indigo">Auto</span>
                        </a>
                    </li>
                </ul>

                <div class="nav-group-label">MANAGEMENT</div>
                <ul class="nav-list">
                    <li>
                        <a href="#team" class="nav-item" data-view="team">
                            <i class="fa-solid fa-id-badge"></i>
                            <span id="navTeamLabel">Staff & Cleaners</span>
                        </a>
                    </li>
                    <li>
                        <a href="#services" class="nav-item" data-view="services">
                            <i class="fa-solid fa-tags"></i>
                            <span>Services & Pricing</span>
                        </a>
                    </li>
                    <li>
                        <a href="#invoices" class="nav-item" data-view="invoices">
                            <i class="fa-solid fa-file-invoice-dollar"></i>
                            <span>Invoices & Stripe</span>
                            <span class="nav-badge badge-danger" id="navOverdueBadge">2</span>
                        </a>
                    </li>
                    <li>
                        <a href="#automations" class="nav-item" data-view="automations">
                            <i class="fa-solid fa-bolt"></i>
                            <span>Automation Engine</span>
                        </a>
                    </li>
                    <li>
                        <a href="#reports" class="nav-item" data-view="reports">
                            <i class="fa-solid fa-chart-line"></i>
                            <span>Reports & KPIs</span>
                        </a>
                    </li>
                </ul>

                <div class="nav-group-label">SYSTEM</div>
                <ul class="nav-list">
                    <li>
                        <a href="#settings" class="nav-item" data-view="settings">
                            <i class="fa-solid fa-gear"></i>
                            <span>Settings & Presets</span>
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- Bottom Mobile Portal Launcher & User Card -->
            <div class="sidebar-footer">
                <button class="btn btn-mobile-sim" id="launchMobileAppBtn">
                    <i class="fa-solid fa-mobile-screen-button"></i>
                    <span>Staff Mobile View</span>
                </button>
                <div class="user-profile-badge">
                    <div class="user-avatar" id="currentRoleAvatar">BO</div>
                    <div class="user-info">
                        <span class="user-name" id="currentUserName">Alex Morgan</span>
                        <span class="user-role" id="currentUserRoleTitle">Business Owner</span>
                    </div>
                    <button class="btn-icon-xs" id="cycleRoleBtn" title="Switch Testing Role (Owner / Admin / Cleaner)">
                        <i class="fa-solid fa-user-gear"></i>
                    </button>
                </div>
            </div>
        </aside>

        <!-- Main Workspace Area -->
        <div class="main-wrapper">
            
            <!-- Global Top Bar -->
            <header class="top-bar">
                <div class="top-bar-left">
                    <button class="mobile-nav-toggle" id="mobileMenuToggle">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="page-breadcrumb">
                        <span class="breadcrumb-root">Operations</span>
                        <i class="fa-solid fa-chevron-right breadcrumb-separator"></i>
                        <span class="breadcrumb-current" id="breadcrumbPageTitle">Dashboard</span>
                    </div>
                </div>

                <div class="top-bar-center">
                    <div class="global-search-bar">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" id="globalSearchInput" placeholder="Search customers, jobs, invoices, addresses... (Press '/' to focus)">
                    </div>
                </div>

                <div class="top-bar-right">
                    <!-- Quick Industry Preset Switcher -->
                    <div class="industry-quick-select">
                        <label for="industrySelector"><i class="fa-solid fa-briefcase"></i> Mode:</label>
                        <select id="industrySelector">
                            <option value="cleaning">Cleaning Company</option>
                            <option value="barber">Barber / Grooming Salon</option>
                            <option value="hotel">Hotel & Hospitality</option>
                            <option value="general">Multi-Service Operating</option>
                        </select>
                    </div>

                    <!-- Autonomous Agent Execution Trigger Button -->
                    <button class="btn btn-agent-pulse btn-sm" id="launchAgentModalBtn" title="Launch Autonomous Operations Agent">
                        <i class="fa-solid fa-robot"></i>
                        <span>Agent Execution</span>
                        <span class="agent-live-dot"></span>
                    </button>

                    <!-- Primary Action Dropdown -->
                    <div class="action-dropdown-wrapper">
                        <button class="btn btn-primary btn-sm" id="quickActionDropdownBtn">
                            <i class="fa-solid fa-plus"></i>
                            <span>Quick Action</span>
                            <i class="fa-solid fa-chevron-down"></i>
                        </button>
                        <div class="dropdown-menu" id="quickActionDropdownMenu">
                            <a href="#" class="dropdown-item" id="quickAddJobBtn"><i class="fa-solid fa-calendar-plus"></i> New Job / Booking</a>
                            <a href="#" class="dropdown-item" id="quickAddLeadBtn"><i class="fa-solid fa-user-plus"></i> New Lead</a>
                            <a href="#" class="dropdown-item" id="quickAddCustomerBtn"><i class="fa-solid fa-address-book"></i> New Customer</a>
                            <a href="#" class="dropdown-item" id="quickCreateInvoiceBtn"><i class="fa-solid fa-file-invoice"></i> Create Invoice</a>
                        </div>
                    </div>

                    <!-- Role Simulator Indicator -->
                    <div class="role-chip" id="currentRoleChip" title="Click to cycle permission roles">
                        <span class="status-dot active"></span>
                        <span id="activeRoleLabel">Owner Mode</span>
                    </div>

                    <!-- Notifications Dropdown -->
                    <div class="notification-wrapper">
                        <button class="btn-icon" id="notificationBtn" title="Activity & Automations">
                            <i class="fa-regular fa-bell"></i>
                            <span class="notification-badge" id="notificationCount">4</span>
                        </button>
                        <div class="notification-panel" id="notificationPanel">
                            <div class="panel-header">
                                <h4>Live System Automations & Alerts</h4>
                                <button class="btn-text-xs" id="clearNotificationsBtn">Clear</button>
                            </div>
                            <div class="notification-list" id="notificationList">
                                <!-- Populated dynamically -->
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Operational Content Container -->
            <main class="content-container">
                
                <!-- VIEW 1: DASHBOARD -->
                <section class="app-view active" id="view-dashboard">
                    <div class="view-header">
                        <div>
                            <h1 class="view-title">Operational Command Centre</h1>
                            <p class="view-subtitle">Real-time pulse of jobs, revenue, staff assignment, and customer pipelines.</p>
                        </div>
                        <div class="view-actions">
                            <button class="btn btn-agent-pulse" id="dashLaunchAgentBtn"><i class="fa-solid fa-wand-magic-sparkles"></i> AI Agent Auto-Triage</button>
                            <button class="btn btn-secondary" id="seedDemoDataBtn"><i class="fa-solid fa-arrows-rotate"></i> Reload Realistic Data</button>
                            <button class="btn btn-primary" id="openNewJobModalBtn"><i class="fa-solid fa-plus"></i> Schedule Job</button>
                        </div>
                    </div>

                    <!-- KPI Cards (Spec Section 5.1 & 6.2) -->
                    <div class="kpi-grid">
                        <div class="kpi-card">
                            <div class="kpi-icon-wrap primary"><i class="fa-solid fa-calendar-day"></i></div>
                            <div class="kpi-content">
                                <span class="kpi-label">JOBS TODAY</span>
                                <div class="kpi-value-row">
                                    <h3 class="kpi-value" id="kpiJobsToday">18</h3>
                                    <span class="trend-badge positive"><i class="fa-solid fa-arrow-up"></i> 100% on track</span>
                                </div>
                                <span class="kpi-meta" id="kpiJobsBreakdown">11 Completed · 4 In Progress</span>
                            </div>
                        </div>

                        <div class="kpi-card">
                            <div class="kpi-icon-wrap success"><i class="fa-solid fa-sterling-sign"></i></div>
                            <div class="kpi-content">
                                <span class="kpi-label">REVENUE TODAY</span>
                                <div class="kpi-value-row">
                                    <h3 class="kpi-value" id="kpiRevenueToday">£840.00</h3>
                                    <span class="trend-badge positive"><i class="fa-solid fa-arrow-trend-up"></i> +18% vs avg</span>
                                </div>
                                <span class="kpi-meta" id="kpiAvgTicket">Avg ticket £76.30</span>
                            </div>
                        </div>

                        <div class="kpi-card">
                            <div class="kpi-icon-wrap warning"><i class="fa-solid fa-clock-rotate-left"></i></div>
                            <div class="kpi-content">
                                <span class="kpi-label">OUTSTANDING REVENUE</span>
                                <div class="kpi-value-row">
                                    <h3 class="kpi-value" id="kpiOutstanding">£260.00</h3>
                                    <span class="trend-badge warning"><i class="fa-solid fa-triangle-exclamation"></i> 2 Overdue</span>
                                </div>
                                <span class="kpi-meta">Chased via Stripe auto-reminders</span>
                            </div>
                        </div>

                        <div class="kpi-card">
                            <div class="kpi-icon-wrap info"><i class="fa-solid fa-user-plus"></i></div>
                            <div class="kpi-content">
                                <span class="kpi-label">NEW LEADS</span>
                                <div class="kpi-value-row">
                                    <h3 class="kpi-value" id="kpiNewLeads">5</h3>
                                    <span class="trend-badge positive">3 Ready to Quote</span>
                                </div>
                                <span class="kpi-meta">64% conversion this month</span>
                            </div>
                        </div>
                    </div>

                    <!-- Operational Grid: Unassigned Jobs + Recurring Jobs + Activity Feed -->
                    <div class="dashboard-grid">
                        
                        <!-- Unassigned Jobs Alert Section -->
                        <div class="card card-warning-accent">
                            <div class="card-header">
                                <div class="card-header-title">
                                    <i class="fa-solid fa-triangle-exclamation text-warning"></i>
                                    <h3>Unassigned Jobs Requiring Staff</h3>
                                </div>
                                <span class="badge badge-warning" id="dashUnassignedCount">3 Needing Staff</span>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="data-table" id="unassignedJobsTable">
                                        <thead>
                                            <tr>
                                                <th>Job / Service</th>
                                                <th>Customer & Location</th>
                                                <th>Scheduled Time</th>
                                                <th>Value</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody id="unassignedJobsTableBody">
                                            <!-- Dynamically injected -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Today's Operations Overview -->
                        <div class="card">
                            <div class="card-header">
                                <div class="card-header-title">
                                    <i class="fa-solid fa-clock"></i>
                                    <h3>Today's Live Operations</h3>
                                </div>
                                <div class="card-pills">
                                    <span class="pill pill-success" id="pillCompleted">11 Done</span>
                                    <span class="pill pill-info" id="pillInProgress">4 In Progress</span>
                                    <span class="pill pill-warning" id="pillPending">3 Unassigned</span>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="progress-bar-stacked">
                                    <div class="progress-segment bg-success" style="width: 61%" title="61% Completed"></div>
                                    <div class="progress-segment bg-info" style="width: 22%" title="22% In Progress"></div>
                                    <div class="progress-segment bg-warning" style="width: 17%" title="17% Unassigned"></div>
                                </div>
                                <div class="mini-jobs-list" id="todayJobsMiniList">
                                    <!-- Populated dynamically -->
                                </div>
                            </div>
                        </div>

                        <!-- Upcoming Recurring Jobs Engine Card -->
                        <div class="card">
                            <div class="card-header">
                                <div class="card-header-title">
                                    <i class="fa-solid fa-repeat text-indigo"></i>
                                    <h3>Automated Recurring Schedules</h3>
                                </div>
                                <button class="btn btn-secondary btn-xs" id="runRecurringEngineBtn">
                                    <i class="fa-solid fa-play"></i> Generate Next Run
                                </button>
                            </div>
                            <div class="card-body">
                                <p class="card-caption">Rules automatically generating upcoming weekly, biweekly, and monthly recurring visits.</p>
                                <div class="recurring-summary-grid">
                                    <div class="mini-stat">
                                        <span class="stat-digit" id="statActiveRecurring">47</span>
                                        <span class="stat-text">Active Schedules</span>
                                    </div>
                                    <div class="mini-stat">
                                        <span class="stat-digit" id="statWeeklyCount">29</span>
                                        <span class="stat-text">Weekly</span>
                                    </div>
                                    <div class="mini-stat">
                                        <span class="stat-digit" id="statBiweeklyCount">18</span>
                                        <span class="stat-text">Bi-weekly</span>
                                    </div>
                                </div>
                                <div class="recurring-preview-list" id="recurringPreviewList">
                                    <!-- Injected dynamically -->
                                </div>
                            </div>
                        </div>

                        <!-- Live Audit & Automation Activity Feed -->
                        <div class="card">
                            <div class="card-header">
                                <div class="card-header-title">
                                    <i class="fa-solid fa-wave-square"></i>
                                    <h3>Live Activity & Automation Log</h3>
                                </div>
                                <span class="badge badge-muted">Real-time</span>
                            </div>
                            <div class="card-body p-0">
                                <div class="activity-feed" id="activityFeedList">
                                    <!-- Injected dynamically -->
                                </div>
                            </div>
                        </div>

                    </div>
                </section>

                <!-- VIEW 2: LEADS & PIPELINE -->
                <section class="app-view" id="view-leads">
                    <div class="view-header">
                        <div>
                            <h1 class="view-title">Leads & Quotes Pipeline</h1>
                            <p class="view-subtitle">Track prospects from inquiry to quote, and convert them to customers in 1 click.</p>
                        </div>
                        <div class="view-actions">
                            <button class="btn btn-primary" id="openNewLeadModalBtn"><i class="fa-solid fa-plus"></i> New Lead</button>
                        </div>
                    </div>

                    <!-- Pipeline Stage Badges -->
                    <div class="pipeline-status-bar" id="leadPipelineFilterBar">
                        <button class="filter-pill active" data-lead-filter="all">All Leads (<span id="countLeadAll">0</span>)</button>
                        <button class="filter-pill" data-lead-filter="New">New (<span id="countLeadNew">0</span>)</button>
                        <button class="filter-pill" data-lead-filter="Contacted">Contacted (<span id="countLeadContacted">0</span>)</button>
                        <button class="filter-pill" data-lead-filter="Quote Sent">Quote Sent (<span id="countLeadQuoteSent">0</span>)</button>
                        <button class="filter-pill" data-lead-filter="Won">Won (<span id="countLeadWon">0</span>)</button>
                        <button class="filter-pill" data-lead-filter="Lost">Lost (<span id="countLeadLost">0</span>)</button>
                    </div>

                    <div class="card">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="data-table" id="leadsTable">
                                    <thead>
                                        <tr>
                                            <th>Prospect Name</th>
                                            <th>Service Requested</th>
                                            <th>Location / Postcode</th>
                                            <th>Estimated Value</th>
                                            <th>Source</th>
                                            <th>Status</th>
                                            <th>Created / Activity</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="leadsTableBody">
                                        <!-- Dynamically generated -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- VIEW 3: CUSTOMERS -->
                <section class="app-view" id="view-customers">
                    <div class="view-header">
                        <div>
                            <h1 class="view-title">Customer Directory</h1>
                            <p class="view-subtitle">Manage customer profiles, multiple properties, service history, and health status.</p>
                        </div>
                        <div class="view-actions">
                            <button class="btn btn-primary" id="openNewCustomerModalBtn"><i class="fa-solid fa-plus"></i> Add Customer</button>
                        </div>
                    </div>

                    <div class="table-toolbar">
                        <div class="search-input-wrapper">
                            <i class="fa-solid fa-search"></i>
                            <input type="text" id="customerSearchInput" placeholder="Search by name, email, phone...">
                        </div>
                        <div class="filter-group">
                            <select id="customerHealthFilter">
                                <option value="all">All Health Statuses</option>
                                <option value="active">Active</option>
                                <option value="overdue">Overdue Balance</option>
                                <option value="at-risk">At-Risk</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="data-table" id="customersTable">
                                    <thead>
                                        <tr>
                                            <th>Customer</th>
                                            <th>Phone & Contact</th>
                                            <th>Properties</th>
                                            <th>Health Status</th>
                                            <th>Total Spent</th>
                                            <th>Last Service</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="customersTableBody">
                                        <!-- Populated dynamically -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- VIEW 4: PROPERTIES / LOCATIONS / UNITS -->
                <section class="app-view" id="view-properties">
                    <div class="view-header">
                        <div>
                            <h1 class="view-title" id="propertiesPageTitle">Properties & Service Locations</h1>
                            <p class="view-subtitle">Store access codes, alarm info, key lockboxes, and site notes for each customer location.</p>
                        </div>
                        <div class="view-actions">
                            <button class="btn btn-primary" id="openNewPropertyModalBtn"><i class="fa-solid fa-plus"></i> Add Property</button>
                        </div>
                    </div>

                    <div class="properties-grid" id="propertiesCardsContainer">
                        <!-- Populated dynamically -->
                    </div>
                </section>

                <!-- VIEW 5: JOBS & BOOKINGS -->
                <section class="app-view" id="view-jobs">
                    <div class="view-header">
                        <div>
                            <h1 class="view-title">Jobs & Scheduled Visits</h1>
                            <p class="view-subtitle">Manage one-off and recurring visits, handle cleaner assignments, and prevent double-booking.</p>
                        </div>
                        <div class="view-actions">
                            <button class="btn btn-primary" id="jobsViewCreateBtn"><i class="fa-solid fa-calendar-plus"></i> New Job</button>
                        </div>
                    </div>

                    <div class="table-toolbar">
                        <div class="filter-group">
                            <select id="jobStatusFilter">
                                <option value="all">All Statuses</option>
                                <option value="Scheduled">Scheduled</option>
                                <option value="Confirmed">Confirmed</option>
                                <option value="In Progress">In Progress</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>

                            <select id="jobStaffFilter">
                                <option value="all">All Staff Members</option>
                                <!-- Injected dynamically -->
                            </select>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="data-table" id="jobsTable">
                                    <thead>
                                        <tr>
                                            <th>Job # / Service</th>
                                            <th>Customer & Location</th>
                                            <th>Date & Time</th>
                                            <th>Duration</th>
                                            <th>Assigned Staff</th>
                                            <th>Status</th>
                                            <th>Price</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="jobsTableBody">
                                        <!-- Dynamically injected -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- VIEW 6: LIVE CALENDAR -->
                <section class="app-view" id="view-calendar">
                    <div class="view-header">
                        <div>
                            <h1 class="view-title">Operational Calendar</h1>
                            <p class="view-subtitle">Visual day and week scheduling grid with staff assignments and conflict detection.</p>
                        </div>
                        <div class="view-actions">
                            <div class="calendar-view-toggles">
                                <button class="btn btn-sm btn-secondary active" id="calendarViewWeekBtn">Week View</button>
